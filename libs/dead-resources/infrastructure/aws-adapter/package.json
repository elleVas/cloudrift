{
  "name": "dead-resources-infrastructure-aws-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cloudrift/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:infrastructure"
    ],
    "targets": {
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/{projectRoot}"
        ],
        "options": {
          "jestConfig": "libs/dead-resources/infrastructure/aws-adapter/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1104.0",
    "@aws-sdk/client-cloudformation": "^3.1104.0",
    "@aws-sdk/client-cloudwatch": "^3.1104.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1104.0",
    "@aws-sdk/client-ec2": "^3.1104.0",
    "@aws-sdk/client-ecr": "^3.1104.0",
    "@aws-sdk/client-eventbridge": "^3.1104.0",
    "@aws-sdk/client-iam": "^3.1104.0",
    "@aws-sdk/client-route-53": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/client-sfn": "^3.1104.0",
    "@aws-sdk/client-sns": "^3.1104.0",
    "@smithy/types": "^4.9.0",
    "dead-resources-domain": "workspace:*",
    "shared-aws-infra-utils": "workspace:*",
    "shared-kernel": "workspace:*",
    "tslib": "^2.8.1"
  }
}
