{
  "name": "cloud-cost-infrastructure-aws-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cloudrift/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:infrastructure"
    ],
    "targets": {
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/{projectRoot}"
        ],
        "options": {
          "jestConfig": "libs/cloud-cost/infrastructure/aws-adapter/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1104.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1104.0",
    "@aws-sdk/client-codepipeline": "^3.1104.0",
    "@aws-sdk/client-docdb": "^3.1104.0",
    "@aws-sdk/client-dynamodb": "^3.1104.0",
    "@aws-sdk/client-ec2": "^3.1104.0",
    "@aws-sdk/client-ecr": "^3.1104.0",
    "@aws-sdk/client-efs": "^3.1104.0",
    "@aws-sdk/client-eks": "^3.1104.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1104.0",
    "@aws-sdk/client-elasticache": "^3.1104.0",
    "@aws-sdk/client-fsx": "^3.1104.0",
    "@aws-sdk/client-kafka": "^3.1104.0",
    "@aws-sdk/client-kinesis": "^3.1104.0",
    "@aws-sdk/client-lambda": "^3.1104.0",
    "@aws-sdk/client-mq": "^3.1104.0",
    "@aws-sdk/client-neptune": "^3.1104.0",
    "@aws-sdk/client-opensearch": "^3.1104.0",
    "@aws-sdk/client-pricing": "^3.1104.0",
    "@aws-sdk/client-rds": "^3.1104.0",
    "@aws-sdk/client-redshift": "^3.1104.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1104.0",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/client-sagemaker": "^3.1104.0",
    "@aws-sdk/client-secrets-manager": "^3.1104.0",
    "@aws-sdk/client-sqs": "~3.1104.0",
    "@aws-sdk/client-sts": "^3.1104.0",
    "@aws-sdk/client-workspaces": "^3.1104.0",
    "@smithy/types": "^4.9.0",
    "cloud-cost-domain": "workspace:*",
    "cloud-cost-pricing": "workspace:*",
    "shared-aws-infra-utils": "workspace:*",
    "shared-kernel": "workspace:*",
    "tslib": "^2.8.1"
  }
}
