{
  "name": "resource-security-infrastructure-aws-adapter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cloudrift/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:infrastructure"
    ],
    "targets": {
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{workspaceRoot}/coverage/{projectRoot}"
        ],
        "options": {
          "jestConfig": "libs/resource-security/infrastructure/aws-adapter/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1119.0",
    "@aws-sdk/client-cloudtrail": "^3.1119.0",
    "@aws-sdk/client-config-service": "^3.1119.0",
    "@aws-sdk/client-ec2": "^3.1119.0",
    "@aws-sdk/client-ecr": "^3.1119.0",
    "@aws-sdk/client-guardduty": "^3.1119.0",
    "@aws-sdk/client-iam": "^3.1119.0",
    "@aws-sdk/client-kms": "^3.1119.0",
    "@aws-sdk/client-lambda": "^3.1119.0",
    "@aws-sdk/client-rds": "^3.1119.0",
    "@aws-sdk/client-redshift": "^3.1119.0",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/client-s3-control": "^3.1119.0",
    "@aws-sdk/client-secrets-manager": "^3.1119.0",
    "@aws-sdk/client-securityhub": "^3.1119.0",
    "@aws-sdk/client-sns": "^3.1119.0",
    "@aws-sdk/client-sqs": "~3.1119.0",
    "@smithy/types": "^4.17.0",
    "resource-security-domain": "workspace:*",
    "shared-aws-infra-utils": "workspace:*",
    "shared-kernel": "workspace:*",
    "tslib": "^2.8.1"
  }
}
